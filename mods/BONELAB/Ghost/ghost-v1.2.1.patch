+        SetAnchors(gloss.rectTransform, 0.5f, 0.5f, 0.5f, 0.5f);
+        gloss.rectTransform.sizeDelta = new Vector2(limbW * 0.5f, limbH * 0.8f);
+        gloss.rectTransform.anchoredPosition = new Vector2(-limbW * 0.18f, 0f);
