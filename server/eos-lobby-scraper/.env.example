POSTGRES_DSN=postgresql://client_writer:CHANGE_ME@62.109.21.131:5432/clientdb
SCRAPE_INTERVAL_SEC=15
SCRAPE_ONCE=0
FUSION_GAME_NAME=BONELAB
# New lobby appearance → LOADING for this many seconds, then IN GAME
LOADING_SEC=3
# Optional: comma-separated known LobbyCodes (PRIVATE lobbies are joinable/findable by code)
LOBBY_CODES=
# How many cached codes to re-probe each cycle (rotating)
CODE_PROBE_BUDGET=40

# Presence hardening
OFFLINE_MISS_STREAK=2
COLLAPSE_RATIO=0.35
ADVISORY_LOCK=1

# EOS identity (per-server account)
# Each host gets its own DeviceId/ProductUserId under data/eos-identity.json + data/eos-cache/.
# Set to 1 once to force mint a brand-new account (then set back to 0).
EOS_FORCE_NEW_ACCOUNT=0
# On InvalidAuth the scraper always DeleteDeviceId → new identity → CreateUser automatically.
