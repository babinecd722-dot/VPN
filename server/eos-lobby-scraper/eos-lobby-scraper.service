[Unit]
Description=BONELAB Fusion EOS lobby scraper → Postgres
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/eos-lobby-scraper
EnvironmentFile=/opt/eos-lobby-scraper/.env
ExecStart=/usr/bin/dotnet /opt/eos-lobby-scraper/EosLobbyScraper.dll
Restart=always
RestartSec=15
# Optional: drop privileges after install
# User=scraper
# Group=scraper

[Install]
WantedBy=multi-user.target
