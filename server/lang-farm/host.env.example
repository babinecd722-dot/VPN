# /opt/fusion-lobby-host/.env
FUSION_HOST_MODE=1
FUSION_GAME_NAME=BONELAB
# U+00B7 MIDDLE DOT instead of ASCII '.' — reads www·bonelab·fun, bypasses LinkFilter.
# (ZWSP-after-dot used to work; Quest/Fusion now renders those as "?".)
HOST_LOBBY_NAME=www·bonelab·fun
HOST_LOBBY_DESC=www·bonelab·fun
HOST_LEVEL_TITLE=Halfway Park
HOST_LEVEL_BARCODE=fa534c5a83ee4ec6bd641fec424c4142.Level.LevelHalfwayPark
BOT_NICK=coolguy
HOST_HOLD_SEC=0
HOST_P2P_PORT=17877
HOST_MAX_MEMBERS=8
# Browser-only pad (LobbyInfo). 7 keeps Full=False so Find still lists the lobby.
HOST_DISPLAY_PLAYERS=7
HOST_MARK_FULL=0
EOS_DATA_DIR=/opt/fusion-lobby-host/data
EOS_FORCE_NEW_ACCOUNT=0
# Fusion 0.2.1 LabFusion.dll credentials (rotated DeploymentId + ClientSecret).
# EOS_DEPLOYMENT_ID=f3fdf691aa6c4004abdb1e19665c1429
# EOS_CLIENT_SECRET=SWDxYlWWsEgvmD0o3qAm2RMZoSZzOfYo5yvX/uikH94
# HOST_LOBBY_VERSION=1.14.2

# Optional: static TMP shimmer LobbyName (generate via gen_shimmer_lobby_name.py)
# HOST_LOBBY_NAME=<color=#ffc030>w...
